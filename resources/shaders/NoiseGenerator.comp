#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba8, binding = 0) uniform image3D outputImage;

float hash13(vec3 p)
{
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

vec3 randomPoint(vec3 cell, float period, float seed)
{
    cell = mod(cell, period);
    cell = mod(cell + period, period);

    return vec3(
        hash13(cell + seed * 13.17),
        hash13(cell + seed * 27.31),
        hash13(cell + seed * 41.73)
    );
}

float Noise(float cells, float seed)
{
    ivec3 pixel = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(outputImage);

    vec3 uv = (vec3(pixel) + 0.5) / vec3(size);

    vec3 gridPos = uv * cells;
    vec3 cell = floor(gridPos);
    vec3 localPos = fract(gridPos);

    float minDistance = 1e10;

    for(int y = -1; y <= 1; ++y)
    {
        for(int x = -1; x <= 1; ++x)
        {
            for(int z = -1; z <= 1; ++z)
            {
                vec3 neighbour = vec3(x,y,z);

                vec3 featurePoint = randomPoint(cell + neighbour, cells, seed);

                vec3 delta = neighbour + featurePoint - localPos;

                float distance = dot(delta,delta);

                minDistance = min(minDistance,distance);
            }
        }
    }

    return sqrt(minDistance);
}


void main()
{
    ivec3 voxel = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(outputImage);

    if(voxel.x >= size.x || voxel.y >= size.y || voxel.z >= size.z)
        return;

    // TODO ADD A SEED PROPERTY
    float F1 = max(0, 1 - Noise(16,11.1));
    float F2 = max(0, 1 - Noise(32,15.4));

    float D1 = max(0, 1 - Noise(64,10.1));
    float D2 = max(0, 1 - Noise(128,2.0));
    
    imageStore(outputImage,voxel, vec4(F1,F2,D1,D2));

}
